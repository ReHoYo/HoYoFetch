# ─── HoYoFetch Configuration ───────────────────────
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# Your Revolt bot token (required)
BOT_TOKEN=your_bot_token_here

# Server controlled by the VPS-only emergency Send Messages lock.
# Required only for npm run emergency:lock/status/unlock.
EMERGENCY_SERVER_ID=

# Stoat REST endpoint used by the VPS-only emergency command.
STOAT_API_BASE=https://api.stoat.chat

# Command prefix (default: /)
PREFIX=/

# How often to auto-fetch new codes, in minutes (default: 60)
FETCH_INTERVAL=60

# Minimum seconds between manual /Fetch* commands per channel (default: 10, 0 disables)
FETCH_COOLDOWN=10

# Emoji style: "unicode" for fallback emoji, "custom" for Revolt server emoji
# See config.js for instructions on setting up custom emoji
EMOJI_MODE=unicode

# ─── Audit log (/Enable-AuditLog) ──────────────────

# Verbose per-event console logging for the audit log (1 = on, default: off)
AUDITLOG_DEBUG=

# Max size (MB) of one attachment to mirror into Logger on Stoat (default: 20; 0 disables attachment archiving)
AUDITLOG_EVIDENCE_MAX_MB=20

# ─── Post gate (/Post-Gate) ────────────────────────

# Hours a member may sit in full Post Gate before Irminsul reminds moderators
# that the hold is still standing (default: 24, min 1, max 168). Irminsul never
# releases a hold automatically — the reminder offers Release / Continue Holding.
POST_GATE_HOLD_REMINDER_HOURS=24
